LCD_OPERATOR = "+\u00b1+"
OCD_OPERATOR = "+\u2260+"
WORD_RE = re.compile(r"[A-Za-z0-9_'-]{2,}")
SENTENCE_RE = re.compile(r"(?<=[.!?])\s+")
STOP = {
    "a","an","the","and","or","but","if","then","than","to","of","in","on","at","for","from",
    "with","without","by","as","is","are","was","were","be","been","being","it","this","that",
    "these","those","i","you","he","she","they","we","me","my","your","our","their","his","her"
}


def words(text: str) -> set[str]:
    return {w.lower() for w in WORD_RE.findall(str(text)) if w.lower() not in STOP}


def stable_id(*parts: Any, size: int = 12) -> str:
    raw = "|".join(str(p) for p in parts)
    return hashlib.sha256(raw.encode("utf-8", "replace")).hexdigest()[:size]


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()


def jaccard(a: Iterable[str], b: Iterable[str]) -> float:
    aa, bb = set(a), set(b)
    if not aa and not bb:
        return 1.0
    if not aa or not bb:
        return 0.0
    return len(aa & bb) / len(aa | bb)


def clamp(v: float, lo: float = 0.0, hi: float = 1.0) -> float:
    return max(lo, min(hi, v))


@dataclass(slots=True)
class Provenance:
    line: int
    store: str = "null"  # .book | .qt | null
    reread: int = 0
    used: int = 0

    def stamp(self) -> str:
        return f"{self.line}:{self.store}:rr{self.reread}:u{self.used}"

    @classmethod
    def parse(cls, value: str) -> "Provenance":
        m = re.fullmatch(r"(\d+):(\.book|\.qt|null):rr(\d+):u(\d+)", value.strip())
        if not m:
            raise ValueError(f"Invalid Quant provenance: {value}")
        return cls(int(m.group(1)), m.group(2), int(m.group(3)), int(m.group(4)))


@dataclass(slots=True)
class Triple:
    subject: str
    relation: str
    object: str
    confidence: float = 0.6
    source: str = ""
    provenance: Provenance | None = None
    record_id: str = ""

    def __post_init__(self) -> None:
        if not self.record_id:
            self.record_id = stable_id(self.subject, self.relation, self.object, self.source, self.provenance.line if self.provenance else 0)

    def key(self) -> tuple[str, str, str]:
        return (self.subject.lower().strip(), self.relation.lower().strip(), self.object.lower().strip())

    def terms(self) -> set[str]:
        return words(f"{self.subject} {self.relation} {self.object}")

    def text(self) -> str:
        return f"{self.subject} | {self.relation} | {self.object}"


